#!/bin/bash
# Download NSD experiment metadata files.
#
# Source: s3://natural-scenes-dataset/nsddata/experiments/nsd/
# Requires: AWS CLI (aws s3 cp --no-sign-request)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT_DIR="${OUT_DIR:-${SCRIPT_DIR}/../../nsd_data/experiment}"

mkdir -p "${OUT_DIR}"

S3_BASE="s3://natural-scenes-dataset/nsddata/experiments/nsd"

for FILE in nsd_expdesign.mat nsd_stim_info_merged.csv; do
    if [[ -f "${OUT_DIR}/${FILE}" ]]; then
        echo "skip (exists): ${OUT_DIR}/${FILE}"
    else
        echo "${S3_BASE}/${FILE} -> ${OUT_DIR}/${FILE}"
        aws s3 cp "${S3_BASE}/${FILE}" "${OUT_DIR}/${FILE}" --no-sign-request
    fi
done

echo "Done. Files saved under ${OUT_DIR}"
